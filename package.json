{
	"name": "verifpal",
	"displayName": "Verifpal",
	"version": "1.0.12",
	"publisher": "symbolicsoft",
	"description": "Verifpal language support.",
	"author": {
		"name": "Nadim Kobeissi",
		"email": "nadim@symbolic.software"
	},
	"license": "GPL-3.0-only",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"icon": "res/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/symbolicsoft/verifpal-vscode.git"
	},
	"homepage": "https://verifpal.com",
	"bugs": {
		"url": "https://github.com/symbolicsoft/verifpal-vscode/issues"
	},
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "verifpal",
				"aliases": [
					"Verifpal",
					"verifpal"
				],
				"extensions": [
					".vp"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "verifpal",
				"scopeName": "source.verifpal",
				"path": "./syntax/verifpal.tmLanguage"
			}
		],
		"commands": [
			{
				"command": "verifpal.path",
				"title": "Verifpal: Show Path to Verifpal"
			},
			{
				"command": "verifpal.verify",
				"title": "Verifpal: Run Attacker Analysis"
			},
			{
				"command": "verifpal.showDiagram",
				"title": "Verifpal: Show Protocol Diagram"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Verifpal Configuration",
			"properties": {
				"verifpal.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable or disable Verifpal integration"
				},
				"verifpal.path": {
					"type": "string",
					"default": "",
					"description": "Path to Verifpal binary"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"check-types": "tsc --noEmit",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.75.0",
		"esbuild": "^0.27.3",
		"eslint": "^9.39.5",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.66.0"
	},
	"dependencies": {
		"cross-spawn": "^7.0.6"
	}
}
