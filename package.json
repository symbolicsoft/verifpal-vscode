{
	"name": "verifpal",
	"displayName": "Verifpal",
	"version": "2.0.0",
	"publisher": "symbolicsoft",
	"description": "Verifpal language support.",
	"author": {
		"name": "Nadim Kobeissi",
		"email": "nadim@symbolic.software"
	},
	"license": "GPL-3.0-only",
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Programming Languages",
		"Linters",
		"Formatters",
		"Visualization"
	],
	"keywords": [
		"verifpal",
		"formal verification",
		"cryptography",
		"protocol",
		"security"
	],
	"icon": "res/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/symbolicsoft/verifpal-vscode.git"
	},
	"homepage": "https://verifpal.com",
	"bugs": {
		"url": "https://github.com/symbolicsoft/verifpal-vscode/issues"
	},
	"main": "./dist/extension.js",
	"extensionKind": [
		"workspace"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Verifpal provides IDE features by running the Verifpal binary as a language server. In an untrusted workspace, the binary is taken from your user settings or your PATH: a workspace-level 'verifpal.path' is ignored, so that opening an untrusted repository cannot cause an arbitrary executable to be run.",
			"restrictedConfigurations": [
				"verifpal.path"
			]
		}
	},
	"contributes": {
		"languages": [
			{
				"id": "verifpal",
				"aliases": [
					"Verifpal",
					"verifpal"
				],
				"extensions": [
					".vp"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "verifpal",
				"scopeName": "source.verifpal",
				"path": "./syntax/verifpal.tmLanguage"
			}
		],
		"snippets": [
			{
				"language": "verifpal",
				"path": "./snippets/verifpal.json"
			}
		],
		"commands": [
			{
				"command": "verifpal.verify",
				"title": "Run Attacker Analysis",
				"category": "Verifpal",
				"icon": "$(shield)"
			},
			{
				"command": "verifpal.cancel",
				"title": "Cancel Attacker Analysis",
				"category": "Verifpal"
			},
			{
				"command": "verifpal.showDiagram",
				"title": "Show Protocol Diagram",
				"category": "Verifpal",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "verifpal.showOutput",
				"title": "Show Analysis Output",
				"category": "Verifpal"
			},
			{
				"command": "verifpal.clearResults",
				"title": "Clear Analysis Results",
				"category": "Verifpal"
			},
			{
				"command": "verifpal.restart",
				"title": "Restart Language Server",
				"category": "Verifpal"
			},
			{
				"command": "verifpal.path",
				"title": "Show Path to Verifpal",
				"category": "Verifpal"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "verifpal.verify",
					"when": "editorLangId == verifpal"
				},
				{
					"command": "verifpal.cancel",
					"when": "editorLangId == verifpal"
				},
				{
					"command": "verifpal.showDiagram",
					"when": "editorLangId == verifpal"
				},
				{
					"command": "verifpal.clearResults",
					"when": "editorLangId == verifpal"
				}
			],
			"editor/title": [
				{
					"command": "verifpal.verify",
					"when": "editorLangId == verifpal",
					"group": "navigation@1"
				},
				{
					"command": "verifpal.showDiagram",
					"when": "editorLangId == verifpal",
					"group": "navigation@2"
				}
			],
			"editor/context": [
				{
					"command": "verifpal.verify",
					"when": "editorLangId == verifpal",
					"group": "verifpal@1"
				},
				{
					"command": "verifpal.showDiagram",
					"when": "editorLangId == verifpal",
					"group": "verifpal@2"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "Verifpal",
			"properties": {
				"verifpal.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable Verifpal IDE features. Takes effect immediately; no window reload is needed.",
					"scope": "window"
				},
				"verifpal.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the Verifpal binary, which is also the language server (`verifpal lsp`). Leave empty to use `verifpal` from your `PATH`. Requires Verifpal 1.1 or newer. Ignored in an untrusted workspace.",
					"scope": "machine-overridable"
				},
				"verifpal.validateOnType": {
					"type": "boolean",
					"default": true,
					"scope": "window",
					"description": "Check models for parse and sanity errors as you type, and report them in the Problems panel. Disable to check only on save."
				},
				"verifpal.analyzeOnSave": {
					"type": "boolean",
					"default": false,
					"description": "Run a full attacker analysis every time a model is saved. Off by default: analysis of a large model can take a long time.",
					"scope": "window"
				},
				"verifpal.sessions": {
					"type": [
						"number",
						"null"
					],
					"default": null,
					"scope": "window",
					"minimum": 1,
					"maximum": 16,
					"markdownDescription": "Sessions per principal for the attacker analysis. Leave unset to use Verifpal's own default of 2. Session replication costs roughly four times the work; `1` is the escape hatch for a model too large to afford it."
				},
				"verifpal.diagnostics.passing": {
					"type": "boolean",
					"default": true,
					"scope": "window",
					"description": "Also mark queries that hold, as informational entries in the Problems panel."
				},
				"verifpal.inlayHints.argumentNames": {
					"type": "boolean",
					"default": true,
					"scope": "window",
					"description": "Show primitive argument names inline at call sites."
				},
				"verifpal.codeLens": {
					"type": "boolean",
					"default": true,
					"scope": "window",
					"description": "Show a 'Run attacker analysis' action above the queries block."
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "verifpal",
				"scopes": {
					"namespace": [
						"entity.name.type.verifpal"
					],
					"variable.declaration": [
						"variable.other.definition.verifpal"
					],
					"function.defaultLibrary": [
						"support.function.verifpal"
					],
					"decorator": [
						"storage.modifier.verifpal"
					],
					"type": [
						"keyword.other.query.verifpal"
					],
					"parameter": [
						"storage.type.verifpal"
					]
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"compile-tests": "tsc -p ./tsconfig.json",
		"check-types": "tsc --noEmit",
		"lint": "eslint .",
		"pretest:unit": "npm run compile-tests",
		"test:unit": "mocha",
		"pretest:integration": "npm run compile-tests && npm run package",
		"test:integration": "vscode-test",
		"test": "npm run test:unit && npm run test:integration"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.0.0",
		"@types/vscode": "~1.82.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"mocha": "^11.8.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.67.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	}
}
